{
  "name": "satisfactory-planner",
  "productName": "Satisfactory Planner",
  "version": "1.8.0",
  "description": "Production planner and factory calculator for Satisfactory",
  "author": "joogiebear <joogiebear@protonmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "dist": "vite build && electron-builder --win",
    "extract-data": "python tools/extract_game_data.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-meshes": "node tools/fetch-meshes.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "meshoptimizer": "^1.2.0"
  },
  "build": {
    "appId": "com.joogiebear.satisfactoryplanner",
    "productName": "Satisfactory Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Satisfactory Planner",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName} ${version} portable.${ext}"
    },
    "extraResources": [
      {
        "from": "tools/mesh-exporter/publish",
        "to": "mesh-exporter",
        "filter": [
          "**/*",
          "!*.pdb",
          "!*.xml"
        ]
      }
    ]
  }
}
